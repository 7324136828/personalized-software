{
  "name": "learning-content-viewers",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "React port of the tkinter launchers for generated learning content",
  "scripts": {
    "sync": "node scripts/sync-data.mjs",
    "predev": "npm run sync",
    "dev": "vite",
    "prebuild": "npm run sync",
    "build": "tsc -b && vite build",
    "build:only": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "~5.9.0",
    "vite": "^8.2.0"
  }
}
