{
  "name": "learning-content-viewers",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "React port of the tkinter launchers for generated learning content",
  "scripts": {
    "dev": "node scripts/run-python.mjs python_backend/server.py --dev",
    "dev:frontend": "vite",
    "build": "tsc -b && vite build",
    "start": "node scripts/run-python.mjs python_backend/server.py",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "~5.9.0",
    "vite": "^8.2.0"
  }
}
